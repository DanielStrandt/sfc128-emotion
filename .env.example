# Absolute or relative path to the trained Stage-2-v2 exported model directory.
# Default is ./models/SFC128_Emotion; no downloads are done at startup.
SFC128_MODEL_DIR=./models/SFC128_Emotion
# auto enables FP32 CUDA Graph replay on CUDA and uses eager PyTorch otherwise.
# Set to 0 to force eager inference, or 1 to require CUDA Graphs.
SFC128_CUDA_GRAPHS=auto
